unset GOROOT
unset GOARCH
unset GOOS
unset GOPATH
unset GOBIN

unset gvm_go_name
unset gvm_pkgset_name

mkdir -p "$GVM_ROOT/logs" > /dev/null 2>&1
mkdir -p "$GVM_ROOT/gos" > /dev/null 2>&1
mkdir -p "$GVM_ROOT/archive" > /dev/null 2>&1
mkdir -p "$GVM_ROOT/archive/package" > /dev/null 2>&1
mkdir -p "$GVM_ROOT/environments" > /dev/null 2>&1

export GVM_VERSION=$(cat "$GVM_ROOT/VERSION")
export PATH="$GVM_ROOT/bin:$PATH"
export GVM_PATH_BACKUP="$PATH"
# scripts/functions loads the function files once per shell (issue #3); clear
# its guard so that sourcing the integration again picks up the current files.
__gvm_functions_loaded=""
. "$GVM_ROOT/scripts/functions"
# The default environment is loaded through gvm_source_environment so that
# the GVM_ROOT recorded in it does not replace the one set above (issue #28).
[ -f "$GVM_ROOT/environments/default" ] && gvm_source_environment "$GVM_ROOT/environments/default"
. "$GVM_ROOT/scripts/env/gvm"

. "$GVM_ROOT/scripts/env/cd" && cd .

#!/usr/bin/env bash

# Override the cd() function to implement auto-switching of go version and
# pkgset when changing into a directory.

. "$GVM_ROOT/scripts/functions" || return 1
. "$GVM_ROOT/scripts/function/_bash_pseudo_hash" || return 1
. "$GVM_ROOT/scripts/function/_shell_compat" || return 1

# user could be reloading this file, restore preserved functions if we've been
# through here already.
if __gvm_is_function __gvm_oldcd; then
    # output from declare -f on zsh omits a newline before opening brace, so
    # we need to add the newline for consistency with bash.
    eval "$(echo "cd()"; declare -f __gvm_oldcd | sed '1 s/{/\'$'\n''{/' | tail -n +2)"
    unset -f __gvm_oldcd
fi

if __gvm_is_function cd; then
    eval "$(echo "__gvm_oldcd()"; declare -f cd | sed '1 s/{/\'$'\n''{/' | tail -n +2)"
else
    # cd is not a function, so delegate to the builtin. This must not depend
    # on the output of 'type cd': bash localizes that message, so comparing it
    # against the English text left __gvm_oldcd undefined under any other
    # locale and turned cd() into a no-op (issue #6).
    __gvm_oldcd() { builtin cd "$@"; }
fi

# Path cleanup
#
# Sort all paths, place rvm paths first, followed by gvm, followed by the rest.
# We do this so that rvm and gvm can live together happily.
#
# NOTE: Cleanup will also take place everytime 'gvm use' or 'gvm pkgset use' is
# executed but we do it now just to call it from some place on login.
#
export PATH="$(__gvm_munge_path)"

# cd()
# /*!
# @abstract Override the cd() function to implement auto-switching of go version
#   and pkgset when changing into a directory
# @discussion
# This override seeks to preserve the functionality of any pre-existing override
#  of the cd() function.
# @param path Path of directory to change into
# @return Returns success (status 0) or failure (status 1).
# */

cd() {
    # @FIXME: gvm_oldcd is broken on re-sourcing .bashrc!
    if __gvm_is_function __gvm_oldcd; then
        # Propagate the real cd's status: when the directory change itself
        # fails, "cd x && ..." must not continue, and there is nothing to
        # auto-switch either (issue #8).
        __gvm_oldcd "$@" || return $?
    fi

    local dot_go_version dot_go_pkgset rslt
    local defaults_go_name defaults_go_pkgset
    local defaults_resolved=false

	if [[ "$GVM_ROOT" == "" ]]; then
		display_error "GVM_ROOT not set. Please source \$GVM_ROOT/scripts/gvm"
		return $?
	fi

    # gather default environment settings, they can change at any time!
    #
    # This runs on every cd, so it must stay cheap: __gvmp_read_defaults parses
    # the file with shell builtins only and assigns defaults_go_name and
    # defaults_go_pkgset directly, instead of going through
    # __gvm_read_environment_file and the pseudo-hash accessors, which fork a
    # subshell per key (issue #1).
    [[ "${GVM_DEBUG}" -eq 1 ]] && echo "Resolving defaults..."
    if __gvmp_read_defaults "${GVM_ROOT}/environments/default"; then
        defaults_resolved=true
    else
        [[ "${GVM_DEBUG}" -eq 1 ]] && echo "Can't find default environment. Falling back to system."
        if __gvmp_read_defaults "${GVM_ROOT}/environments/system"; then
            defaults_resolved=true
        else
            [[ "${GVM_DEBUG}" -eq 1 ]] && echo "Can't find system environment."
        fi
    fi

    if [[ "${defaults_resolved}" == false ]]; then
        # Neither a default nor a system environment file exists -- the state a
        # gvm install leaves behind when the machine has no go on PATH.
        #
        # Resolving a fallback runs `gvm list` inside a command substitution,
        # which forks several subshells. Doing that on every cd is the same
        # fork-per-cd problem as issue #1, just in the branch that fix did not
        # cover: on a macOS runner it costs ~325ms per cd (issue #49). The
        # answer only changes when the set of installed versions changes, so it
        # is resolved once per shell; gvm() clears the cache, and every command
        # that installs, removes or switches a version goes through gvm().
        if [[ "${__gvmp_fallback_cached}" != true ]]; then
            [[ "${GVM_DEBUG}" -eq 1 ]] && echo "Resolving fallback go version from all available."
            __gvmp_fallback_go_name="$(__gvm_resolve_fallback_version)"
            __gvmp_fallback_cached=true
        fi
        defaults_go_name="${__gvmp_fallback_go_name}"

        # The fallback pkgset is deliberately not resolved here. Its value is
        # read only by the two debug branches below -- the `gvm pkgset use`
        # that would have consumed it is commented out -- and unlike the
        # version it depends on $PWD, so it cannot be cached across
        # directories. Anything that starts using defaults_go_pkgset for real
        # has to resolve it here again, and pay for it.
        if [[ "${GVM_DEBUG}" -eq 1 ]]; then
            defaults_go_pkgset="$(__gvm_resolve_fallback_pkgset "${defaults_go_name}")"
        fi

        [[ "${GVM_DEBUG}" -eq 1 ]] && echo "======================================="
        [[ "${GVM_DEBUG}" -eq 1 ]] && echo "fallback_go_version => $defaults_go_name"
        [[ "${GVM_DEBUG}" -eq 1 ]] && echo "fallback_go_pkgset => $defaults_go_pkgset"
        [[ "${GVM_DEBUG}" -eq 1 ]] && echo "======================================="
        defaults_resolved=true
    fi

    [[ "${GVM_DEBUG}" -eq 1 ]] && echo "+++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
    [[ "${GVM_DEBUG}" -eq 1 ]] && echo "defaults_go_name => $defaults_go_name"
    [[ "${GVM_DEBUG}" -eq 1 ]] && echo "defaults_go_pkgset => $defaults_go_pkgset"
    [[ "${GVM_DEBUG}" -eq 1 ]] && echo "+++++++++++++++++++++++++++++++++++++++++++++++++++++++++"

    if [[ "${GVM_DEBUG}" -eq 1 ]]; then
        echo "Resolved default go: ${defaults_go_name:-[EMPTY]}"
        echo "Resolved default pkgset: ${defaults_go_pkgset:-[EMPTY]}"
    fi

    # Both files are looked up in one walk, so that the version switch below
    # can tell whether the shell is already in the state the two files ask
    # for. The pkgset is applied after the version, as before.
    local use_gopkgset="" pkgset_rslt=1
    __gvmp_find_dot_files
    rslt=1
    [[ -n "${dot_go_version}" ]] && rslt=0
    [[ -n "${dot_go_pkgset}" ]] && pkgset_rslt=0
    [[ ${pkgset_rslt} -eq 0 ]] && __gvmp_read_dot_go_pkgset "${dot_go_pkgset}"

    [[ "${GVM_DEBUG}" -eq 1 ]] && echo "---------------------------------------"
    [[ "${GVM_DEBUG}" -eq 1 ]] && echo "dot_go_version => $dot_go_version"
    [[ "${GVM_DEBUG}" -eq 1 ]] && echo "defaults_go_name => $defaults_go_name"
    [[ "${GVM_DEBUG}" -eq 1 ]] && echo "---------------------------------------"

    if [[ $rslt -eq 0 ]]; then
        [[ "${GVM_DEBUG}" -eq 1 ]] && echo "Found dot_go_version: ${dot_go_version}"
        local use_goversion=""
        __gvmp_read_dot_go_version "${dot_go_version}"
        if [[ -n "${use_goversion}" ]]; then
            # The file is found from every directory below it (issue #11), so
            # this branch runs on each cd inside a project. `gvm use` forks
            # dozens of processes and leaves the shell on the version's global
            # pkgset, or on the one .go-pkgset names once that is applied
            # below; when that is already the state, there is nothing to do.
            if [[ "${use_goversion}" == "${gvm_go_name}" && "${gvm_pkgset_name}" == "${use_gopkgset:-global}" ]]; then
                [[ "${GVM_DEBUG}" -eq 1 ]] && echo "Already using: ${use_goversion}"
            else
                [[ "${GVM_DEBUG}" -eq 1 ]] && echo "Switching to: ${use_goversion}"
                gvm use "${use_goversion}" || return 1
            fi
        else
            # The file holds nothing that reads as a version. The directory
            # change itself has already succeeded, so this is not a cd()
            # failure: say what is being ignored and keep the current version,
            # instead of running `gvm use ""` and returning 1 (issue #10).
            display_warning "Ignoring ${dot_go_version}: it does not contain a go version"
        fi
        unset use_goversion
    elif [[ -n "${defaults_go_name}" ]]; then
        [[ "${GVM_DEBUG}" -eq 1 ]] && echo "No .go-version found. Using system or default go."
        # gvm use --quiet "${defaults_go_name}" || return 1
        # gvm use "${defaults_go_name}" || return 1
    else
        # quietly failing
        if [[ "${GVM_DEBUG}" -eq 1 ]]; then
            echo "No fallback go version could be found."
            if [[ ! -d "$GVM_ROOT/archive/go" ]]; then
                echo "$(locale_text_for_key "go_install_prompt")"
            fi
        fi

        # not a cd() error, just a gvm error...need to pretend nothing happened!
        return 0
    fi

    rslt=${pkgset_rslt}
    [[ "${GVM_DEBUG}" -eq 1 ]] && echo "--------------------------------"
    [[ "${GVM_DEBUG}" -eq 1 ]] && echo "dot_go_pkgset => $dot_go_pkgset"
    [[ "${GVM_DEBUG}" -eq 1 ]] && echo "--------------------------------"
    if [[ $rslt -eq 0 ]]; then
        [[ "${GVM_DEBUG}" -eq 1 ]] && echo "Found .go-pkgset: ${dot_go_pkgset}"
        if [[ -n "${use_gopkgset}" && "${use_gopkgset}" == "${gvm_pkgset_name}" ]]; then
            [[ "${GVM_DEBUG}" -eq 1 ]] && echo "Already using pkgset: ${use_gopkgset}"
        else
            [[ "${GVM_DEBUG}" -eq 1 ]] && echo "Switching to: ${use_gopkgset}"
            gvm pkgset use "${use_gopkgset}" || return 1
        fi
        unset use_gopkgset
    elif [[ -n "${defaults_go_pkgset}" ]];then
        [[ "${GVM_DEBUG}" -eq 1 ]] && echo "No .go-pkgset found. Using system or default pkgset."
        [[ "${GVM_DEBUG}" -eq 1 ]] && echo "----------    defaults_go_pkgset => $defaults_go_pkgset     ----------"
        # gvm pkgset use --quiet "${defaults_go_pkgset}" || return 1
    else
        # quietly failing
        [[ "${GVM_DEBUG}" -eq 1 ]] && echo "No fallback pkgset could be found."
    fi

    return 0
}

# __gvmp_read_defaults()
# /*!
# @abstract Read gvm_go_name and gvm_pkgset_name from an environment file
# @discussion
# Fork-free equivalent of __gvm_read_environment_file for the two keys cd()
#   needs. Lines are parsed with the same rules: a line containing '#' is
#   skipped, and only lines of the form 'export VAR; VAR="VALUE"' count, the
#   last occurrence of a key winning. The values are assigned to the caller's
#   defaults_go_name and defaults_go_pkgset variables.
#
# The lines are matched with case patterns rather than a regex: on every cd
#   this is the single largest cost, and a regex match per line ran at about
#   six times the cost of the patterns, before the setopt/unsetopt calls the
#   regex needed under zsh.
# @param path Path to environment file
# @return Returns success (status 0) if at least one line was parsed, or
#   failure (status 1) if the file is unreadable or contains no parseable line.
# */
__gvmp_read_defaults() {
    local filepath="${1}"
    local _line __val
    local parsed=false

    defaults_go_name=""
    defaults_go_pkgset=""

    if [[ -n "${filepath}" && -r "${filepath}" ]]; then
        while IFS=$'\n' read -r _line || [[ -n "${_line}" ]]; do
            case "${_line}" in
                # skip comment lines
                *"#"*) continue ;;
                "export gvm_go_name;"*"gvm_go_name="*)
                    # strip leading and trailing quotes
                    __val="${_line#*gvm_go_name=}"; __val="${__val#\"}"
                    defaults_go_name="${__val%\"}"
                    parsed=true ;;
                "export gvm_pkgset_name;"*"gvm_pkgset_name="*)
                    __val="${_line#*gvm_pkgset_name=}"; __val="${__val#\"}"
                    defaults_go_pkgset="${__val%\"}"
                    parsed=true ;;
                "export "*";"*"="*)
                    parsed=true ;;
            esac
        done < "${filepath}"
    fi

    [[ "${parsed}" == true ]]
}

# __gvmp_find_dot_files()
# /*!
# @abstract Locate the .go-version and .go-pkgset files that apply to the
#   current directory
# @discussion
# Assigns the paths to the caller's dot_go_version and dot_go_pkgset variables
#   (empty when none is found). Each file is looked for in $PWD and then in
#   every parent directory up to $HOME or /, so a file at the root of a
#   project applies everywhere inside it (issue #11); the two are found
#   independently, the nearest instance of each winning. This runs on every
#   cd, so it is one walk over the path with parameter expansion and file
#   tests only: no forks, and no second pass for the second file.
# @return Returns success (status 0) if at least one file was found or failure
#   (status 1).
# */
__gvmp_find_dot_files() {
    local current_dir="${PWD}"
    local highest_dir="${HOME%/}"

    dot_go_version=""
    dot_go_pkgset=""

    # One file test per level in the usual case where neither file is there.
    # The loop stops at highest_dir, or at "" once "${current_dir%/*}" has
    # consumed the last component; the directory it stops at is checked
    # after the loop, so highest_dir is included and "" reads the root
    # directory as "/.go-version".
    while [[ -n "${current_dir}" && "${current_dir}" != "${highest_dir}" ]]; do
        if [[ -f "${current_dir}/.go-version" || -f "${current_dir}/.go-pkgset" ]]; then
            [[ -z "${dot_go_version}" && -f "${current_dir}/.go-version" ]] && dot_go_version="${current_dir}/.go-version"
            [[ -z "${dot_go_pkgset}" && -f "${current_dir}/.go-pkgset" ]] && dot_go_pkgset="${current_dir}/.go-pkgset"
            [[ -n "${dot_go_version}" && -n "${dot_go_pkgset}" ]] && return 0
        fi
        current_dir="${current_dir%/*}"
    done
    [[ -z "${dot_go_version}" && -f "${current_dir}/.go-version" ]] && dot_go_version="${current_dir}/.go-version"
    [[ -z "${dot_go_pkgset}" && -f "${current_dir}/.go-pkgset" ]] && dot_go_pkgset="${current_dir}/.go-pkgset"

    [[ -n "${dot_go_version}" || -n "${dot_go_pkgset}" ]]
}

# __gvmp_read_dot_go_version()
# /*!
# @abstract Read the go version named in a .go-version file
# @discussion
# Assigns the version to the caller's use_goversion variable (empty when the
#   file holds none). The file is read with the shell's own read builtin and
#   the result is assigned, not printed: with the file found from every
#   directory of a project this runs on each cd inside one, and the previous
#   `$(cat file)` cost two forks per call.
# @param filepath Path to the .go-version file
# @return Returns success (status 0) if a version was found or failure (status 1).
# */
__gvmp_read_dot_go_version() {
    local filepath="${1}"
    local _line
    local regex='^(go([0-9]+(\.[0-9]+)*))$'
    # goenv, asdf and the go.mod toolchain directive write the version without
    # the "go" prefix; that form is accepted and named the way `gvm install`
    # names it (issue #10).
    local bare_regex='^([0-9]+(\.[0-9]+)*)$'

    use_goversion=""

    [[ -r "${filepath}" ]] || return 1

    while IFS=$'\n' read -r _line || [[ -n "${_line}" ]]; do
        # skip comment lines
        [[ "${_line}" =~ \#.* ]] && continue

        # looking for pattern "go1.2[.3]"
        if [[ "${_line}" =~ ${regex} ]]; then
            use_goversion="${_line}"
            break
        fi
        # or the bare "1.2[.3]"
        if [[ "${_line}" =~ ${bare_regex} ]]; then
            use_goversion="go${_line}"
            break
        fi
    done < "${filepath}"

    if [[ -z "${use_goversion}" ]]; then
        return 1
    fi

    return 0
}

# __gvmp_read_dot_go_pkgset()
# /*!
# @abstract Read the pkgset named in a .go-pkgset file
# @discussion
# Assigns the pkgset to the caller's use_gopkgset variable (empty when the
#   file holds none). Read with builtins only, like __gvmp_read_dot_go_version.
# @param filepath Path to the .go-pkgset file
# @return Returns success (status 0) if a pkgset was found or failure (status 1).
# */
__gvmp_read_dot_go_pkgset() {
    local filepath="${1}"
    local _line
    local regex='^([A-Za-z0-9._#:%\+\-]+)$'

    use_gopkgset=""

    [[ -r "${filepath}" ]] || return 1

    while IFS=$'\n' read -r _line || [[ -n "${_line}" ]]; do
        # skip comment lines
        [[ "${_line}" =~ \#.* ]] && continue

        # fairly loose naming convention, exclude @ symbol
        if [[ "${_line}" =~ ${regex} ]]; then
            use_gopkgset="${_line}"
            break
        fi
    done < "${filepath}"

    if [[ -z "${use_gopkgset}" ]]; then
        return 1
    fi

    return 0
}

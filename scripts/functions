#!/usr/bin/env bash

# Load the function files once per shell. Every entry point sources this file:
# scripts/env/gvm and scripts/env/cd both do on every shell startup, and so
# does each scripts/* subcommand, so without a guard the files below were read
# twice per startup (issue #3). The guard holds the shell's pid rather than a
# flag: a child process has a different $$ and still loads them even when the
# variable reaches it through the environment, while a subshell, which
# inherits the functions, skips the reload. scripts/gvm-default clears it, so
# `source $GVM_ROOT/scripts/gvm` always reloads.
if [[ "${__gvm_functions_loaded:-}" == "$$" ]]; then
	return 0
fi

# Every file gvm sources is sourced with `builtin .`, here and in each script,
# including the two lines the installer writes to scripts/gvm. A plain `.` is
# subject to alias expansion when a file is sourced into an interactive shell,
# so a user alias on `.` (an `alias .='echo'` is not unusual) fired on gvm's
# own lines: scripts/gvm-default was never read and `gvm use` ended in
# "command not found" (issue #21). `builtin` is a builtin in bash and zsh and
# costs no fork.

for function in $GVM_ROOT/scripts/function/*; do
	# function names preceded by an underscore should be loaded by other
	# scripts explicitly as needed.
	if [[ "${function##*/}" =~ ^_ ]]; then
		continue
	fi

	builtin . "$function"
done

__gvm_functions_loaded="$$"

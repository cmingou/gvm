#!/usr/bin/env bash

# __gvm_find_path_upwards()
# /*!
# @abstract Search upwards through the directory tree for a target file or
#   directory and return the path to the first instance found
# @discussion
# Searches upwards through the directory tree starting at start_dir for a target
#   file or directory basename. Every directory from start_dir up to and
#   including final_dir is checked; the search also stops at the root of the
#   file system.
# @param target Basename of file or directory to find
# @param start_dir [optional] Path to starting directory of search, defaults to
#   present working directory.
# @param final_dir [optional] Path to ending directory of search (that is the
#   highest directory in the tree that will be checked), defaults to user home
#   directory.
# @return Returns a string containing path of found file or directory (status 0)
#   or an empty string (status 1) on failure.
# */
__gvm_find_path_upwards() {
    local target="${1}"
    local start_dir="${2:-$PWD}"
    local final_dir="${3:-$HOME}"
    local __gvmp_found_path=""

    if [[ \
        "x${target}" == "x" || \
        "x${start_dir}" == "x" || \
        "x${final_dir}" == "x"
        ]]
    then
        echo "" && return 1
    fi

    __gvmp_find_path_for_target "${target}" "${start_dir}" "${final_dir}"
    echo "${__gvmp_found_path}"

    if [[ -z "${__gvmp_found_path}" ]]; then
        return 1
    fi

    return 0
}

# __gvmp_find_path_for_target()
# /*!
# @abstract Walk up the directory tree looking for a target, without forking
# @discussion
# The walk is done with parameter expansion and file tests only: cd() runs it
#   on every directory change, so it must not fork. The result is assigned to
#   the caller's __gvmp_found_path variable rather than printed, so that the
#   caller does not need a command substitution to read it (issue #11).
# @param target Basename of file or directory to find
# @param start_dir Path to starting directory of search; "~" and "." are
#   resolved, a relative path is taken relative to $PWD
# @param final_dir Highest directory that will be checked
# @return Returns success (status 0) if the target was found, with its path in
#   __gvmp_found_path, or failure (status 1) with __gvmp_found_path empty.
# */
__gvmp_find_path_for_target() {
    local target="${1}"
    local current_dir="${2}"
    local highest_dir="${3}"
    local candidate=""

    __gvmp_found_path=""

    if [[ ${#target} -eq 0 || ${#current_dir} -eq 0 ]]; then
        return 1
    fi

    case "${current_dir}" in
        "~") current_dir="${HOME}" ;;
        "~/"*) current_dir="${HOME}${current_dir#\~}" ;;
        ".") current_dir="${PWD}" ;;
        /*) ;;
        *) current_dir="${PWD}/${current_dir}" ;;
    esac

    # a trailing slash would make the comparison with highest_dir fail; the
    # root directory itself is spelled "/" again below.
    highest_dir="${highest_dir%/}"

    while :; do
        current_dir="${current_dir%/}"
        [[ -z "${current_dir}" ]] && current_dir="/"

        candidate="${current_dir%/}/${target}"
        if [[ -f "${candidate}" || -d "${candidate}" ]]; then
            __gvmp_found_path="${candidate}"
            return 0
        fi

        if [[ "${current_dir}" == "/" || "${current_dir}" == "${highest_dir}" ]]; then
            return 1
        fi

        current_dir="${current_dir%/*}"
    done
}

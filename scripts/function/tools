#!/usr/bin/env bash
LS_ERROR="GVM couldn't find ls"
TR_ERROR="GVM couldn't find tr"
SED_ERROR="GVM couldn't find sed"
GREP_ERROR="GVM couldn't find grep"
SORT_ERROR="GVM couldn't find sort"
HEAD_ERROR="GVM couldn't find head"

# __gvm_locate_tool()
# /*!
# @abstract Find an executable on PATH with shell builtins only
# @discussion
# Walks PATH and sets __gvm_tool_path to the first regular, executable file
#   named tool. This replaces one "$(unalias tool; command -v tool)" per tool:
#   seven command substitutions, so seven forks, every time this file was
#   sourced, which was twice per shell startup (issue #3). Walking PATH also
#   yields the binary when a shell function of the same name exists, which
#   "command -v" reported instead. Empty PATH entries, which stand for the
#   current directory, are skipped.
# @param tool Name of the tool to find
# @return Returns success (status 0) with __gvm_tool_path set to the path of
#   the tool, or failure (status 1) with __gvm_tool_path empty.
# */
__gvm_locate_tool() {
	local tool="${1}"
	local rest="${PATH}"
	local dir=""
	__gvm_tool_path=""

	[[ -z "${tool}" ]] && return 1

	while [[ -n "${rest}" ]]; do
		dir="${rest%%:*}"
		if [[ "${rest}" == *:* ]]; then
			rest="${rest#*:}"
		else
			rest=""
		fi
		[[ -z "${dir}" ]] && continue
		if [[ -f "${dir}/${tool}" && -x "${dir}/${tool}" ]]; then
			__gvm_tool_path="${dir}/${tool}"
			return 0
		fi
	done

	return 1
}

__gvm_locate_tool ls && LS_PATH="${__gvm_tool_path}" || display_error "$LS_ERROR" || return 1
__gvm_locate_tool tr && TR_PATH="${__gvm_tool_path}" || display_error "$TR_ERROR" || return 1
__gvm_locate_tool sed && SED_PATH="${__gvm_tool_path}" || display_error "$SED_ERROR" || return 1
__gvm_locate_tool grep && GREP_PATH="${__gvm_tool_path}" || display_error "$GREP_ERROR" || return 1
__gvm_locate_tool sort && SORT_PATH="${__gvm_tool_path}" || display_error "$SORT_ERROR" || return 1
__gvm_locate_tool head && HEAD_PATH="${__gvm_tool_path}" || display_error "$HEAD_ERROR" || return 1

# egrep is deliberately not on this list: gvm_export_path was its only user
# and no longer runs any tool, and a missing egrep used to abort this file
# before SORT_PATH and HEAD_PATH were set (issue #16).
#
# Exported so that the functions consuming them (gvm use, gvm pkgset use)
# still find them in an environment that carries gvm's
# functions but not the shell's unexported variables (issue #15). Kept apart
# from the assignments above: `export VAR=$(cmd)` would hide cmd's status.
export LS_PATH TR_PATH SED_PATH GREP_PATH SORT_PATH HEAD_PATH

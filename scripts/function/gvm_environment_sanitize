#!/usr/bin/env bash

# gvm_environment_sanitize()
# /*!
# @abstract Reconcile the GOROOT recorded in an environment file with the go
#   binary that actually resolves on PATH
# @discussion
# When the go binary found on PATH does not live below the GOROOT that the
#   environment file declares, the file is rewritten so that GOROOT points at
#   the location the active go reports, and the file is sourced again.
#
# The file is only ever rewritten with a non-empty, changed GOROOT: writing an
#   empty value corrupts the file and makes every later call fail with
#   "sed: first RE may not be empty" (issue #23). The rewrite uses awk's
#   literal index()/substr() rather than "sed -i", whose in-place syntax
#   differs between GNU and BSD sed and leaves a stray "<name>-e" backup file
#   behind on macOS, and rather than the shell's own pattern substitution,
#   which bash 3.2 and bash 5 quote differently (issue #48).
# @param name Name of the environment file below $GVM_ROOT/environments
# @return Returns success (status 0) when nothing needed to change or the file
#   was rewritten, or failure (status 1) if the file could not be written.
# */
function gvm_environment_sanitize() {
	local env_file="$GVM_ROOT/environments/$1"
	local ACTIVE_GO="$(command -v go)"
	local OLD_GOROOT="$GOROOT"
	local NEW_GOROOT=""

	# nothing to reconcile: no go on PATH, no GOROOT recorded, or the active go
	# already lives below the recorded GOROOT.
	[[ -z "${ACTIVE_GO}" || -z "${OLD_GOROOT}" ]] && return 0
	[[ "${ACTIVE_GO}" == "${OLD_GOROOT}/bin/go" ]] && return 0

	NEW_GOROOT="$(unset GOROOT; go env GOROOT 2> /dev/null)"

	# never write an empty or unchanged value into tracked state.
	[[ -z "${NEW_GOROOT}" || "${NEW_GOROOT}" == "${OLD_GOROOT}" ]] && return 0
	[[ -f "${env_file}" ]] || return 0

	# Replace with awk's index()/substr(), which are literal: no glob pattern,
	# no regex metacharacters and no "&" backreference in the replacement. The
	# shell's own "${var//pat/rep}" is not used here because quoting inside it
	# is not handled the same way by the bash 3.2 that macOS ships as by bash 5
	# (issue #48), and leaving the quotes off would make a path containing a
	# glob character expand. Writing through a temporary file keeps the
	# original intact if the rewrite fails, and avoids "sed -i", whose syntax
	# differs between GNU and BSD.
	local tmp_file="${env_file}.gvm-sanitize.$$"
	OLD_GOROOT="${OLD_GOROOT}" NEW_GOROOT="${NEW_GOROOT}" awk '
		BEGIN { old = ENVIRON["OLD_GOROOT"]; new = ENVIRON["NEW_GOROOT"] }
		{
			out = ""
			while ((i = index($0, old)) > 0) {
				out = out substr($0, 1, i - 1) new
				$0 = substr($0, i + length(old))
			}
			print out $0
		}
	' "${env_file}" > "${tmp_file}" || { rm -f "${tmp_file}"; return 1; }
	mv "${tmp_file}" "${env_file}" || { rm -f "${tmp_file}"; return 1; }

	gvm_source_environment "${env_file}" &> /dev/null
	return 0
}

#!/usr/bin/env bash

. "$GVM_ROOT/scripts/function/_shell_compat" || return 1

# __gvm_resolve_fallback_pkgset()
# /*!
# @abstract Determine applicable fallback pkgset for go version
# @discussion
# When normal go pkgset resolution fails the fallback function will attempt to
#   find a suitable fallback from the installed go pkgsets for the specfied
#   go version name.
#
# If a local pkgset is found in the current directory, then that pkgset will be
# selected.
#
# The pkgsets are checked with directory tests. This used to run
#   `gvm pkgset list` inside a command substitution, which forked a child
#   shell, ls, sed and basename per pkgset and cost about 950ms on a macOS
#   runner (issue #5).
# @param version [optional] Go version name for which to find a fallback pkgset,
#   defaults to the currently exported go_version_name.
# @return Returns a string containing the fallback version name (status 0) or an
#   empty string (status 1) on failure.
# */

__gvm_resolve_fallback_pkgset() {
    __gvmp_resolve_fallback_pkgset "$@"

    echo "${__gvmp_resolved_pkgset}"

    if [[ -z "${__gvmp_resolved_pkgset}" ]]
    then
        return 1
    fi

    return 0
}

# __gvmp_resolve_fallback_pkgset()
# /*!
# @abstract Fork-free core of __gvm_resolve_fallback_pkgset
# @discussion
# Assigns the fallback pkgset to __gvmp_resolved_pkgset (empty when there is
#   none) instead of printing it, so that a caller can read it without a
#   command substitution.
# @param version [optional] Go version name, defaults to gvm_go_name.
# @return Returns success (status 0) if a pkgset was found or failure (status 1).
# */
__gvmp_resolve_fallback_pkgset() {
    local version="${1:-$gvm_go_name}"

    __gvmp_resolved_pkgset=""

    [[ "x${version}" == "x" ]] && return 1

    # `gvm pkgset list` lists nothing for a version without a pkgsets directory
    [[ -d "${GVM_ROOT}/pkgsets/${version}" ]] || return 1

    # a local pkgset in the current directory itself comes first, then the
    # version's global pkgset, in the order the listing printed them
    if [[ -d "${PWD}/.gvm_local" ]]
    then
        __gvmp_resolved_pkgset="${PWD}"
    elif [[ -d "${GVM_ROOT}/pkgsets/${version}/global" ]]
    then
        __gvmp_resolved_pkgset="global"
    fi

    [[ -n "${__gvmp_resolved_pkgset}" ]]
}
